.{
    // hull's C libraries, built as static libraries by the Zig their pins
    // need. A build of its own, as visor's conformance build is: the
    // family's ghostty pin and raylib 6.0 build with Zig 0.16.0, hull with
    // 0.17.0, and the C ABI is the seam between them.
    .name = .hull_libs,
    .version = "0.0.0",
    .minimum_zig_version = "0.16.0",
    .fingerprint = 0xc45088fbb40bde1a,
    .paths = .{ "build.zig", "build.zig.zon" },
    .dependencies = .{
        // The tree at git commit b32f20f3e8d25bb925ec545c54498e93518e7ced,
        // as tycho, morse and visor pin it.
        .ghostty = .{
            .url = "https://github.com/ghostty-org/ghostty/archive/b32f20f3e8d25bb925ec545c54498e93518e7ced.tar.gz",
            .hash = "ghostty-1.3.2-dev-5UdBC464cgX-VbPn16E1sGGBjQa8BRM9Eprp1xin7uVV",
        },
        // Windows, input, OpenGL: Ghostling's route, at its 6.0 release.
        .raylib = .{
            .url = "git+https://github.com/raysan5/raylib?ref=6.0#dbc56a87da87d973a9c5baa4e7438a9d20121d28",
            .hash = "raylib-6.0.0-whq8uCSwLgWWeF3ec3dbG6Rr36SLFL-s2WJ1Q_2E22Bb",
        },
    },
}
