// WAKE as an app: hull's window around the game, unchanged inside. This
// file belongs to WAKE (its repository will carry it); hull keeps it here
// for the spike.
.{
    .name = "WAKE",
    .id = "dev.pedronaugusto.wake",
    .version = "0.0.0",
    .program = .{"wake"},
    // packaging: where the game is built, and its icon (a placeholder)
    .program_source = "../../../wake/zig-out/bin/wake",
    .icon = "icon.png",
    .window = .{
        .cols = 100,
        .rows = 30,
        .min_cols = 80,
        .min_rows = 24,
        // one window, no tabs, no new windows: hull's defaults, said here
        .tabs = false,
        .new_windows = false,
        .program_title = false,
    },
    .terminal = .{
        .font_size = 14,
        .theme = "rose-pine",
        .background_opacity = 100,
        .padding_x = 12,
        .padding_y = 12,
        .cursor_style = .block,
        .cursor_blink = false,
        .option_as_alt = true,
    },
}
